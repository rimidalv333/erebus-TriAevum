# TriAevum for the PlayStation 5 - CMake toolchain over the builder kit's SDK.
#   -DPS5_KIT=/path/to/kit (the folder holding sdk/, vulkan/, lib/)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES PS5_KIT PS5_DEPS_PREFIX)
if(NOT PS5_KIT)
	message(FATAL_ERROR "toolchain.cmake: -DPS5_KIT=<kit folder> is required")
endif()
set(PS5_PAYLOAD_SDK ${PS5_KIT}/sdk)
set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(PROSPERO TRUE)
set(PS5 TRUE)
set(CMAKE_C_COMPILER ${PS5_PAYLOAD_SDK}/bin/prospero-clang)
set(CMAKE_CXX_COMPILER ${PS5_PAYLOAD_SDK}/bin/prospero-clang++)
set(CMAKE_AR ${PS5_PAYLOAD_SDK}/bin/llvm-ar)
set(CMAKE_RANLIB ${PS5_PAYLOAD_SDK}/bin/llvm-ranlib)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH ${PS5_PAYLOAD_SDK}/target ${PS5_DEPS_PREFIX})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
set(CMAKE_POSITION_INDEPENDENT_CODE OFF)
# The console's CPU is a Zen 2.
set(PS5_COMMON_FLAGS "-march=znver2 -ffunction-sections -fdata-sections -fno-omit-frame-pointer")
set(CMAKE_C_FLAGS_INIT "${PS5_COMMON_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${PS5_COMMON_FLAGS} -fexperimental-library -DSPDLOG_NO_EXCEPTIONS")
# An init array, in source order (see the kit's tools/cc-init-array.sh).
set(CMAKE_C_COMPILER_LAUNCHER sh ${PS5_KIT}/ps5/tools/cc-init-array.sh)
set(CMAKE_CXX_COMPILER_LAUNCHER sh ${PS5_KIT}/ps5/tools/cc-init-array.sh)

set(CMAKE_C_COMPILER_FRONTEND_VARIANT GNU)
set(CMAKE_CXX_COMPILER_FRONTEND_VARIANT GNU)
