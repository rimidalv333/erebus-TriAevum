diff --git a/CMakeLists.txt b/CMakeLists.txt
index e45b53e..bb4964a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1469,6 +1469,33 @@ elseif(EMSCRIPTEN)
   CheckLibUnwind()
 
 elseif(UNIX AND NOT APPLE AND NOT RISCOS AND NOT HAIKU)
+  # The PlayStation 5 (the toolchain sets PS5): a FreeBSD-like system for
+  # threads, time and files, with the console's own video, audio and pad
+  # drivers, kept outside this tree in SDL_PS5_PORT_DIR.
+  if(PS5)
+    if(NOT SDL_PS5_PORT_DIR OR NOT SDL_PS5_PLATFORM_DIR)
+      message(FATAL_ERROR "PS5: set SDL_PS5_PORT_DIR (the drivers) and SDL_PS5_PLATFORM_DIR (platform.h)")
+    endif()
+    include_directories("${SDL_PS5_PLATFORM_DIR}" "${SDL2_SOURCE_DIR}/src")
+    if(SDL_AUDIO)
+      set(SDL_AUDIO_DRIVER_PS5 1)
+      list(APPEND SOURCE_FILES "${SDL_PS5_PORT_DIR}/SDL_ps5audio.c")
+      set(HAVE_SDL_AUDIO TRUE)
+    endif()
+    if(SDL_JOYSTICK)
+      set(SDL_JOYSTICK_PS5 1)
+      list(APPEND SOURCE_FILES "${SDL_PS5_PORT_DIR}/SDL_ps5joystick.c")
+      set(HAVE_SDL_JOYSTICK TRUE)
+    endif()
+    if(SDL_VIDEO)
+      set(SDL_VIDEO_DRIVER_PS5 1)
+      list(APPEND SOURCE_FILES "${SDL_PS5_PORT_DIR}/SDL_ps5video.c")
+      set(HAVE_SDL_VIDEO TRUE)
+      # Vulkan is RADV, linked into the title: SDL hands out its entry point and a VK_KHR_display surface
+      set(SDL_VIDEO_VULKAN 1)
+      set(HAVE_VULKAN TRUE)
+    endif()
+  endif()
   if(SDL_AUDIO)
     if(SYSV5 OR SOLARIS OR HPUX)
         # Newer Solaris-based systems, like OpenIndiana, don't have this interface anymore. Check for the header first.
@@ -1691,7 +1718,7 @@ elseif(UNIX AND NOT APPLE AND NOT RISCOS AND NOT HAIKU)
   endif()
 
   if(SDL_JOYSTICK)
-    if(FREEBSD OR NETBSD OR OPENBSD OR BSDI)
+    if((FREEBSD OR NETBSD OR OPENBSD OR BSDI) AND NOT PS5)
       CheckUSBHID()
     endif()
     if((LINUX OR FREEBSD) AND HAVE_LINUX_INPUT_H AND NOT ANDROID)
@@ -2962,7 +2989,7 @@ elseif(N3DS)
   endforeach()
 endif()
 
-if(HAVE_VULKAN AND NOT SDL_LOADSO)
+if(HAVE_VULKAN AND NOT SDL_LOADSO AND NOT PS5)
   message(STATUS "Vulkan support is available, but disabled because there's no loadso.")
   set(HAVE_VULKAN FALSE)
   set(SDL_VIDEO_VULKAN 0)
