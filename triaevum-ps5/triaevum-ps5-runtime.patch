diff --git a/runtime/three_ds_recomp/cmake/spirv_pack_to_inc.cmake b/runtime/three_ds_recomp/cmake/spirv_pack_to_inc.cmake
index 1a2684d..3d20591 100644
--- a/runtime/three_ds_recomp/cmake/spirv_pack_to_inc.cmake
+++ b/runtime/three_ds_recomp/cmake/spirv_pack_to_inc.cmake
@@ -1,8 +1,12 @@
 # cmake -DINPUT=<pack> -DOUTPUT=<list> -P spirv_pack_to_inc.cmake
-# The bytes of a SPIR-V pack as a C initializer list, 32 per line, for
-# compilers without #embed.
+# The bytes of a SPIR-V pack as one string literal, 32 bytes per line, for
+# compilers without #embed. A string literal is far cheaper to parse than a
+# brace list with one element per byte (tens of millions for the larger packs).
+# The array it initializes has one extra terminating byte; sources view the pack
+# through TRIAEVUM_SPIRV_PACK_VIEW, which drops it.
 file(READ "${INPUT}" hex HEX)
 string(REGEX REPLACE "(................................................................)" "\\1\n" hex "${hex}")
-string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
-file(WRITE "${OUTPUT}.tmp" "${bytes}\n")
+string(REGEX REPLACE "([0-9a-f][0-9a-f])" "\\\\x\\1" bytes "${hex}")
+string(REGEX REPLACE "\n" "\"\n\"" bytes "${bytes}")
+file(WRITE "${OUTPUT}.tmp" "\"${bytes}\"\n")
 file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
